# ==============================================================================
# SRI SANKARA TV — PRODUCTION MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
ADMIN_PORT=3001
ADMIN_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# DATABASE (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# For local dev / test: mongodb://127.0.0.1:27017/sankara_production
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sankara_production?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sankara_production
MONGODB_USE_MEMORY_FALLBACK=true

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_sri_sankara_production_2026_change_in_prod
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=refresh_secret_key_sri_sankara_production_refresh_2026
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# CORS SETTINGS
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATION: BREVO (EMAIL NOTIFICATIONS)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-placeholder-brevo-api-key
BREVO_SENDER_NAME="Sri Sankara TV Production Desk"
BREVO_SENDER_EMAIL=production@srisankaratv.com
BREVO_ENABLED=false
BREVO_SANDBOX_MODE=true

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATION: MSG91 (VOICE CALLS & SMS)
# ------------------------------------------------------------------------------
MSG91_AUTH_KEY=placeholder_msg91_auth_key
MSG91_CALL_CAMPAIGN_ID=placeholder_msg91_campaign_id
MSG91_CALLER_NUMBER=+914424991234
MSG91_WEBHOOK_SECRET=placeholder_msg91_webhook_secret
MSG91_ENABLED=false
MSG91_SANDBOX_MODE=true

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATION: CALENDAR (GOOGLE CALENDAR / OUTLOOK)
# ------------------------------------------------------------------------------
CALENDAR_PROVIDER=google
# Options: 'google' or 'outlook'
CALENDAR_ENABLED=false
CALENDAR_SANDBOX_MODE=true

# Google Calendar credentials
GOOGLE_CLIENT_ID=placeholder_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback

# Microsoft 365 / Outlook Graph credentials
MICROSOFT_TENANT_ID=placeholder_azure_tenant_id
MICROSOFT_CLIENT_ID=placeholder_azure_client_id
MICROSOFT_CLIENT_SECRET=placeholder_azure_client_secret
MICROSOFT_HEAD_MAILBOX=productionhead@srisankaratv.com

# ------------------------------------------------------------------------------
# SCHEDULED CRON JOBS
# ------------------------------------------------------------------------------
CRON_HOURLY_REMINDERS_ENABLED=true
CRON_VOICE_OUTBOX_ENABLED=true
CRON_CALENDAR_RECONCILE_ENABLED=true
CRON_REMINDER_INTERVAL_MINUTES=60
VOICE_RETRY_DELAY_MINUTES=30
MAX_VOICE_ATTEMPTS=2
